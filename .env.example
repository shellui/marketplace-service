# Copy to .env and set SECRET_KEY before `docker compose up` or `manage.py runserver`.
# python manage.py generate_env --host market.example.com prints a production set.

SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010,http://localhost:5173

# Leave empty to use SQLite at SQLITE_PATH. Compose sets Postgres.
POSTGRES_DATABASE_URL=
POSTGRES_SSL_REQUIRE=false
SQLITE_PATH=
REDIS_URL=

STORAGE_BACKEND=filesystem
MEDIA_ROOT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_ADDRESSING_STYLE=

# Identity JWKS. Install stats verify Bearer tokens with shellui-django.
# Pin IDENTITY_JWKS or IDENTITY_JWKS_FILE in production. Otherwise the URL is
# IDENTITY_JWKS_URL, or {IDENTITY_SERVICE_URL}/.well-known/jwks.json.
IDENTITY_SERVICE_URL=http://localhost:8000
IDENTITY_JWKS_URL=
IDENTITY_JWKS=
IDENTITY_JWKS_FILE=
IDENTITY_ISSUER=
IDENTITY_AUDIENCE=

CORS_ALLOW_ALL_ORIGINS=true
TRUST_PROXY=false
SECURE_SSL_REDIRECT=false
CATALOG_CACHE_SECONDS=60
INSTALL_RATE=30/min
DJANGO_ADMIN_ENABLED=true

SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
MARKETPLACE_SERVICE_PORT=8010
